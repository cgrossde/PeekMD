{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for PeekMD main window. Shipped in every build, including release — see capabilities/debug.json for the debug-only automation permission.",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "*://*" }
      ],
      "deny": [
        { "url": "smb://*" }
      ]
    },
    "store:default",
    "core:window:allow-set-size",
    "core:window:allow-destroy",
    "opener:allow-reveal-item-in-dir"
  ]
}
