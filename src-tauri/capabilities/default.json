{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for PeekMD main window. Shipped in every build, including release — see capabilities/debug.json for the debug-only automation permission.",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "*://*" }
      ]
    },
    "window-state:default",
    "store:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html",
    "core:window:allow-set-size",
    "core:window:allow-destroy",
    "opener:allow-reveal-item-in-dir"
  ]
}
